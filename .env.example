# Copie este archivo como .env y complete con los datos de su proyecto
# (Supabase → Project Settings → API Keys). Sin estas variables, la app usa localStorage.
# En proyectos nuevos use la "publishable key" (sb_publishable_...); funciona igual que la clave anon.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
